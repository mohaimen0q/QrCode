# Admin sign-in for /admin. On Vercel set these in Project -> Settings -> Environment Variables.
ADMIN_USER=
ADMIN_PASSWORD=
# BLOB_STORE_ID is added automatically by Vercel when a Blob store is connected to the project.
# Password change / reset codes are emailed to ADMIN_EMAIL through Resend (resend.com).
# With the default sender (onboarding@resend.dev) Resend only delivers to the email the Resend account was made with.
ADMIN_EMAIL=
RESEND_API_KEY=
# Optional, once a domain is verified in Resend, e.g. Venecia <no-reply@venecia-restaurant.com.ly>
MAIL_FROM=
